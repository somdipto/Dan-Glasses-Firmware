# Copy this file to ".env" (same folder) and paste your own key.
# server/.env is private: it is git-ignored, never commit or share it.
#
# 1) Get a free key at https://console.groq.com/keys
# 2) In the SAME Groq organisation as the key, open this page once, run a short
#    test and click Accept, or Groq refuses the Orpheus voice:
#    https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
#    (If you skip it, replies use the computer's built-in voice instead.)
GROQ_API_KEY=gsk_your_key_here

# --- "Hey Danny" (tested settings) ---
# Only answer sentences that contain "Danny". Whisper often mishears the name;
# sound-alikes in the first two words (Renny, Rani, Hirani...) are matched too.
WAKE_WORD=danny,denny,dani,danni,dany,donny,dannie,rani,ranny,ronny,hirani,hidani,heydanny
# After an answer, follow-up questions within this many seconds don't need "Danny".
FOLLOWUP_SECONDS=10
# Fastest chat model tested on Groq for short spoken answers (~0.15 s).
CHAT_MODEL=qwen/qwen3.8-27b
SYSTEM_PROMPT=Your name is Danny. You are a friendly voice assistant built into a pair of smart glasses, speaking through a small speaker. Answer in one or two short sentences, under 40 words. Use plain spoken English only: no lists, markdown, emojis, URLs or code. If you need live data such as weather or news, say you can't access it.

# --- Optional ---
# PORT=5000
# DISCOVERY_PORT=5001
# LANGUAGE=en
# TTS_VOICE=austin
# WAKE_FUZZY=0              only the exact WAKE_WORD spellings, no sound-alikes
# If Orpheus is refused, the server speaks with the computer's built-in voice
# (Windows speech, or macOS `say`). Set TTS_FALLBACK=off to report the error instead.
# TTS_FALLBACK=system
# On macOS, pick the voice (list them with: say -v ?)
# MAC_VOICE=Samantha
# Keep every recording in server/recordings/ (for tuning)
# SAVE_RECORDINGS=1
