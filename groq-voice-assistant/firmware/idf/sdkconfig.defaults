# Matches the Arduino IDE settings in the README: XIAO_ESP32S3, OPI PSRAM,
# USB CDC On Boot enabled, 8 MB flash, default 8 MB partitions.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_VARIANT="esp32s3"
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL_NONE=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_MAXIMUM_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y

# Upload latency: the default 5760-byte send buffer allows only 4 segments in
# flight, so one lost packet can't trigger fast retransmit and TCP waits for the
# 1.5 s retransmission timeout (seen as 2-5 s uploads). A compressed question is
# 12-30 KB: let it all fly at once, and use SACK to resend just what was lost.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# Arduino's NetworkClientSecure is compiled out without PSK modes (link errors).
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
