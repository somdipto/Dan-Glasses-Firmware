# Reference only. No .env file or private provider inventory is auto-loaded.
# Export reviewed values explicitly on the approved VM; never source the staged inventory.
# tools/smoke_bridge.py --provider-fixture supplies isolated dummy keys and TLS origins.
BRIDGE_DEVICES_FILE=.secrets/devices.json
BRIDGE_TLS_CERT=.secrets/localhost.crt
BRIDGE_TLS_KEY=.secrets/localhost.key
BRIDGE_PORT=8443
BRIDGE_REQUESTS_PER_MINUTE=6
BRIDGE_REQUEST_TIMEOUT=90
BRIDGE_SILENCE_RMS=40

# Explicit selection only; no fallback from a failed real provider to mocks.
# VOICE_BACKEND=pipeline|cartesia-stream. Pipeline alone exposes finite POST /ask.
VOICE_BACKEND=pipeline
SPEECH_BACKEND=mock
REPLY_BACKEND=mock
WEB_SEARCH_BACKEND=disabled

# Cartesia-only managed agent: Cartesia STT/TTS plus managed OpenAI gpt-5.4-mini,
# not a Cartesia-owned LLM. DeepSeek, direct reply providers and search are not called.
# First explicitly create the dedicated resource with tools/cartesia_agent.py;
# reuse its agent_id, agent_version_id and origin. Calls create provider records.
# To switch modes, UNSET SPEECH_BACKEND, REPLY_BACKEND and WEB_SEARCH_BACKEND
# (including the pipeline examples above); conflicting selectors fail startup.
# Do not source a historical provider inventory or put key values in this file.
# VOICE_BACKEND=cartesia-stream
# CARTESIA_BASE_URL=https://api.cartesia.ai
# CARTESIA_KEY_FILE=/absolute/private/path/cartesia.key
# CARTESIA_AGENT_ID=agent_REPLACE_WITH_CREATED_ID
# CARTESIA_AGENT_VERSION_ID=av_REPLACE_WITH_CREATED_VERSION  # drift fails before audio upload
# CARTESIA_VERSION=2026-08-14
# CARTESIA_CA_FILE=/absolute/path/to/private-ca.pem  # fixture only; normally omit
# The approved resource uses Skylar db6b0ed5-d5d3-463d-ae85-518a07d3c2b4,
# model gpt-5.4-mini, no tools/fallback/greeting/check-ins/speculative generation,
# and max_output_tokens=256. Runtime does not create or reconfigure the resource.
# Native HTTPS/WSS GET /voice requires glasses.v1, Bearer and X-Session.
# Audio is live headerless PCM16 mono 16k, never WAV upload/replay.
# Whole stream <=60s, input <=10s, total generated output <=30s including clears.
# Provider turn detection is authoritative; stop_input is not a provider flush.
# Firmware 5.2-duplex keeps physical capture/AEC live through playback; current-turn
# upstream input may stop independently. Acoustic full-duplex acceptance is unverified.
# Only played final revisions commit history. Health never starts a paid call.

# Cartesia batch speech. All fields below are required when SPEECH_BACKEND=cartesia.
# Provider/model/voice entitlement, policy, quota and costs must first be approved.
# SPEECH_BACKEND=cartesia
# CARTESIA_BASE_URL=https://api.cartesia.ai
# CARTESIA_KEY_FILE=/absolute/private/path/cartesia.key
# CARTESIA_STT_MODEL=ink-whisper
# CARTESIA_TTS_MODEL=sonic-3.6  # implemented stable choices: sonic-3, sonic-3.5, sonic-3.6
# CARTESIA_VOICE_ID=  # confirmed account voice ID, never guessed
# CARTESIA_LANGUAGE=  # explicit supported ISO-639-1 language
# CARTESIA_VERSION=2026-08-14
# CARTESIA_CA_FILE=/absolute/path/to/private-ca.pem  # fixture only; normally omit
# Uses verified HTTPS, Bearer auth and Cartesia-Version; TTS wraps raw PCM16 mono 16 kHz in a finite WAV.

# Direct replies. Explicit origin/model/credential and request contract required.
# REPLY_BACKEND=direct
# LLM_BASE_URL=https://platform.yeta.ai/v1  # paused; one prior normal-mode reply passed
# LLM_MODEL=  # actual entitled gateway model ID; do not copy an upstream alias blindly
# LLM_KEY_FILE=/absolute/private/path/llm.key
# LLM_API_STYLE=deepseek  # only if gateway confirms thinking.type=disabled passthrough
# LLM_CA_FILE=/absolute/path/to/private-ca.pem  # normally omit
# Both supported profiles send max_tokens=256 and stream=false, not store/max_completion_tokens.
# deepseek additionally sends thinking:{type:disabled}; openai omits provider-specific thinking.
# Path-prefixed /api/v1 bases are preserved. HTTP is allowed only for numeric loopback tests.

# Real web search transport: documented DIRECT DeepSeek Search API, not assumed Yeta support.
# WEB_SEARCH_BACKEND=deepseek
# WEB_SEARCH_BASE_URL=https://api.deepseek.com
# WEB_SEARCH_KEY_FILE=/absolute/private/path/search.key  # a direct DeepSeek credential, NOT the Yeta key
# WEB_SEARCH_CA_FILE=/absolute/path/to/private-ca.pem  # fixture only; normally omit
# POST /v1/tools/search; query/count=3/need_content=false. No arbitrary URL fetching.
# Shared credentials are accepted only for the same canonical scheme/host/effective port.
# A gateway key is rejected at a different search origin, including after rotation.
# Search opt-in with missing configuration fails startup; no silent fake search/answer.

# Optional explicit offline speech for local evaluation; never an automatic cloud fallback.
# SPEECH_BACKEND=local
# WHISPER_BIN=/absolute/path/to/whisper-cli
# WHISPER_MODEL=/absolute/path/to/models/ggml-tiny.en-q5_1.bin
# PIPER_MODEL=/absolute/path/to/models/en_US-ljspeech-medium.onnx
# STT_LANGUAGE=en
# Hermes selectors are rejected; voice v1 has no Hermes or general-purpose action agent.
